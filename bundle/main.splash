let notes = []
let remember_status = "Tap Remember to also tell the assistant."

fn load(){
    if fs.exists("notes.json") {
        let v = fs.read("notes.json").parse_json()
        if v != nil { notes = v }
    }
    ui.list.render()
}

fn save(){ fs.write("notes.json", notes.to_json()) }

fn add(){
    let text = ui.entry.text()
    if text == "" { return }
    notes.push(text)
    ui.entry.set_text("")
    save()
    ui.list.render()
}

fn remove(i){
    let kept = []
    for j in notes.len() { if j != i { kept.push(notes[j]) } }
    notes = kept
    save()
    ui.list.render()
}

fn remember(text){
    remember_status = "Asking…"
    ui.status.set_text(remember_status)
    ui.list.render()
    host.request("octos.turn.start", {text: "Remember: " + text}, fn(r){
        if r.is_ok {
            remember_status = "Remembered ✅"
        } else {
            remember_status = "Kept locally ✅"
        }
        ui.status.set_text(remember_status)
    })
}

start_timeout(0.05, || load())

let ink = #x1c1c1e
let secondary = #x8e8e93
let accent = #x5856d6
let accent_dark = #x4644b3
let accent_bg = #xeeecfd
let bg = #xf7f7fa
let card = #xffffff
SolidView{width: Fill height: Fill flow: Down padding: 16 spacing: 12 draw_bg.color: bg
    View{width: Fill height: Fit flow: Down spacing: 2
        Label{text: "📝  Memory Notes" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 26}}
        Label{text: "Notes that teach your assistant." draw_text.color: secondary draw_text.text_style.font_size: 13}
    }
    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
        entry := TextInput{width: Fill height: 44 empty_text: "Write a note"
            draw_bg +: {color: #xffffff color_hover: #xffffff color_focus: accent_bg color_empty: #xffffff border_radius: 12.0}
            draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}}
        ButtonFlat{text: "Add" height: 44 padding: Inset{left: 20 right: 20} on_click: || add()
            draw_bg +: {border_radius: 22.0 color: accent color_hover: accent_dark color_down: #x3735a0 border_size: 0.0}
            draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
    }
    list := ScrollYView{width: Fill height: Fill flow: Down spacing: 10 on_render: || {
        if notes.len() == 0 {
            SolidView{width: Fill height: Fit flow: Down padding: Inset{top: 22 bottom: 22 left: 18 right: 18} align: Align{x: 0.5 y: 0.5} draw_bg.color: card
                Label{text: "No notes yet" draw_text.color: secondary draw_text.text_style.font_size: 14}
                Label{text: "Write something above and tap Add." draw_text.color: secondary draw_text.text_style.font_size: 11}
            }
        }
        for i in notes.len() {
            let j = notes.len() - 1 - i
            let row_text = notes[j]
            SolidView{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5} padding: Inset{top: 12 bottom: 12 left: 14 right: 10} draw_bg.color: card
                Label{width: Fill text: row_text draw_text.color: ink draw_text.text_style.font_size: 15}
                ButtonFlat{text: "Remember" height: 30 padding: Inset{left: 12 right: 12} on_click: || remember(row_text)
                    draw_bg +: {border_radius: 15.0 color: accent_bg color_hover: #xddd9fa color_down: #xc7c2f5 border_size: 0.0}
                    draw_text +: {color: accent color_hover: accent_dark color_down: accent_dark}}
                ButtonFlat{text: "×" height: 30 padding: Inset{left: 10 right: 10} on_click: || remove(j)
                    draw_bg +: {border_radius: 15.0 color: #xffffff color_hover: #xf2f2f7 color_down: #xe5e5ea border_size: 0.0}
                    draw_text +: {color: secondary color_hover: ink color_down: ink}}
            }
        }
    }}
    RoundedView{width: Fit height: Fit flow: Right padding: Inset{top: 6 bottom: 6 left: 12 right: 12} draw_bg.color: accent_bg border_radius: 10.0
        status := Label{text: remember_status draw_text.color: accent draw_text.text_style.font_size: 12}
    }
    Label{text: "Notes stay on this device; Remember also tells this app's assistant." draw_text.color: secondary draw_text.text_style.font_size: 12}
}